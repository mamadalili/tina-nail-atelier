generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model AppointmentRequest {
  id             String        @id @default(uuid()) @db.Uuid
  reference      String        @unique @db.VarChar(40)
  idempotencyKey String        @unique @db.Uuid
  payloadHash    String
  name           String        @db.VarChar(80)
  phone          String        @db.VarChar(11)
  service        String        @db.VarChar(20)
  staff          String        @default("tina") @db.VarChar(20)
  manicureType   String?       @db.VarChar(20)
  preferredDay   DateTime      @db.Date
  jalaliDay      String        @db.VarChar(10)
  period         String        @db.VarChar(20)
  note           String        @default("") @db.VarChar(500)
  status         RequestStatus @default(PENDING)
  consentAt      DateTime      @default(now())
  startsAt       DateTime?     @db.Timestamptz(3)
  endsAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  outbox         OutboxEvent[]

  @@index([createdAt])
  @@index([status, preferredDay])
}

model OutboxEvent {
  id          String             @id @default(uuid()) @db.Uuid
  requestId   String             @db.Uuid
  request     AppointmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  channel     String             @db.VarChar(20)
  kind        String             @db.VarChar(20)
  sentAt      DateTime?
  providerMessageId String?    @db.VarChar(255)
  skippedAt   DateTime?
  attempts    Int                @default(0)
  retryAt     DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@index([sentAt, retryAt])
}
