{
  "name": "tina-nail-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 18220",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "worker": "tsx src/server/worker.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.5.4",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "jalaali-js": "2.0.1",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jalaali-js": "1.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
