# Copy locally to .env. Never commit the filled file.
SITE_URL=
DATABASE_URL=
DB_PASSWORD=
BOOKING_ENABLED=false
REDIS_URL=redis://redis:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Backend notifications. Patterns must use name, service, date, time, reference.
ADMIN_PHONE=
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=
SMS_USER_PATTERN=
SMS_ADMIN_PATTERN=
# Approved WhatsApp body variables, in order:
# name, service, date, time, reference, guest phone (E.164).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_ADMIN_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
# Only turn on for an explicitly labelled design preview.
RECEIPT_PREVIEW_ENABLED=false
